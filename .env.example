# ==============================================================================
# WhatsApp Marketing & AI Support Platform - Environment Configuration Template
# Copy this file to .env for local development. Never commit .env files to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime environment: development | production | test
NODE_ENV=development
# Platform deployment stage: local | staging | production
APP_ENV=local

# ------------------------------------------------------------------------------
# 2. BACKEND API CONFIGURATION
# ------------------------------------------------------------------------------
API_PORT=3000
API_HOST=0.0.0.0
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 3. STRUCTURED LOGGING
# ------------------------------------------------------------------------------
# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable colorized logs in development (true | false)
LOG_PRETTY=true

# ------------------------------------------------------------------------------
# 4. LOCAL SUPABASE ENVIRONMENT (Platform Database & Schema Ownership)
# Managed locally via Supabase CLI and Docker (defaults match `supabase start`)
# ------------------------------------------------------------------------------
LOCAL_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODMxOTQ0MDB9.dummy-local-anon-key
LOCAL_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzE5NDQwMH0.dummy-local-service-role-key
LOCAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ------------------------------------------------------------------------------
# 5. EXISTING ECOMMERCE SUPABASE INTEGRATION (Read-Only External Access)
# Strictly treated as an external, read-only datasource. Never run migrations here.
# ------------------------------------------------------------------------------
ECOMMERCE_SUPABASE_URL=https://your-ecommerce-project.supabase.co
ECOMMERCE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-ecommerce-anon-key
# Optional direct read-only connection pool (strictly validates SELECT statements)
# ECOMMERCE_DATABASE_URL_RO=postgresql://readonly_user:readonly_password@db.your-ecommerce-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 6. FUTURE AI PROVIDER CONFIGURATION (Optional for Foundation Milestone)
# ------------------------------------------------------------------------------
AI_PROVIDER=mock
# AI_API_KEY=sk-proj-your-ai-api-key
# AI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 7. FUTURE WHATSAPP PROVIDER CONFIGURATION (Optional for Foundation Milestone)
# ------------------------------------------------------------------------------
WHATSAPP_PROVIDER=mock
# WHATSAPP_API_KEY=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=1001234567890
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_secure_verification_token


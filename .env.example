# ==============================================================================
# WhatsApp Platform - Environment Configuration Template (.env.example)
#
# QUICK START:
# - For local development:  copy to .env.dev (or run `pnpm env:dev`)
# - For production runtime: copy to .env.prod (or run `pnpm env:prod`)
# - Never commit .env, .env.dev, or .env.prod containing credentials to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime environment: development | production | test
NODE_ENV=development
# Platform deployment stage: local | development | staging | production
APP_ENV=local

# ------------------------------------------------------------------------------
# 2. BACKEND API CONFIGURATION
# ------------------------------------------------------------------------------
# Development default: 3001 | Production default: 3000
API_PORT=3000
API_HOST=0.0.0.0
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# 3. STRUCTURED LOGGING
# ------------------------------------------------------------------------------
# Log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable colorized logs in development (true | false)
LOG_PRETTY=true

# ------------------------------------------------------------------------------
# 4. PLATFORM SUPABASE DATABASE (Cloud Supabase - Single Source of Truth)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-platform-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-platform-project.supabase.co/auth/v1/.well-known/jwks.json

# ------------------------------------------------------------------------------
# 5. EXISTING ECOMMERCE SUPABASE INTEGRATION (Read-Only External Access)
# Strictly treated as an external, read-only datasource. Never run migrations here.
# ------------------------------------------------------------------------------
ECOMMERCE_SUPABASE_URL=https://your-ecommerce-project.supabase.co
ECOMMERCE_SUPABASE_ANON_KEY=your-ecommerce-anon-key
ECOMMERCE_SUPABASE_SERVICE_ROLE_KEY=your-ecommerce-service-role-key

# ------------------------------------------------------------------------------
# 6. AI PROVIDER CONFIGURATION (Google Gemini 3.5 Flash Lite)
# ------------------------------------------------------------------------------
# Provider: openai | anthropic | gemini | mock
AI_PROVIDER=gemini
AI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 7. WHATSAPP CLOUD API CONFIGURATION (Meta Direct)
# ------------------------------------------------------------------------------
# Provider: cloud_api | twilio | mock
WHATSAPP_PROVIDER=mock
WHATSAPP_API_KEY=your-whatsapp-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# ------------------------------------------------------------------------------
# 8. INTEGRATIONS & ALERTS
# ------------------------------------------------------------------------------
ECOMMERCE_WEBHOOK_SECRET=your-ecommerce-webhook-secret
ADMIN_ALERT_PHONE_NUMBER=919876543210
